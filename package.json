{
  "name": "@npv12/opencode-context-sidebar",
  "version": "0.3.0",
  "description": "OpenCode TUI sidebar plugin for context usage progress",
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.tsx"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && cp index.ts dist/tui.tsx",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "sidebar",
    "context"
  ],
  "author": "npv12",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/npv12/opencode-context-sidebar.git",
    "directory": "opencode-context-sidebar"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "opencode": ">=1.17.16"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.16",
    "@opentui/core": "^0.4.3",
    "@opentui/solid": "^0.4.3",
    "solid-js": "^1.9.14"
  }
}
